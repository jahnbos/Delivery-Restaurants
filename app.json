{
  "expo": {
    "name": "DeliveryRestaurants",
    "slug": "DeliveryRestaurants",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo/fast-shipping.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/Logo/kfc.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo/kfc.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/Logo/kfc.jpg"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
